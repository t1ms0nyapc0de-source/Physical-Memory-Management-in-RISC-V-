.data
.align 2
pmm_bitmap:
   .word 0
pmm_allocated_bitmap:
   .word 0
pmm_total_blocks:
    .word 0
    
    
.text
# PMM initialization runs during early boot: call it on one hart with
# interrupts disabled.  The bitmap operations are not concurrent-safe.
pmm_set_block:
   # a0 = block.  Bitmap convention: 1 = used/reserved, 0 = free.
   la t6,pmm_total_blocks
   lw t6,0(t6)
   bgeu a0,t6,pmm_set_done

   la t0,pmm_bitmap
   lw t0,0(t0)
   
   srli t1,a0,5
   andi t2,a0,31
   
   #bit shift
   li t3,1
   sll t3,t3,t2
   
   #move to t0[t4]
   slli t1,t1,2
   add t4,t0,t1
   
   #load,change the bit,save
   lw t5, 0(t4)
   or t5,t5,t3
   sw t5,0(t4)
pmm_set_done:
   ret

pmm_clear_block:
   # a0 = block
   la t6,pmm_total_blocks
   lw t6,0(t6)
   bgeu a0,t6,pmm_clear_done

   la t0,pmm_bitmap
   lw t0,0(t0)
   
   srli t1,a0,5
   andi t2,a0,31
   
   #bit shift
   li t3,1
   sll t3,t3,t2
   not t3,t3
   
   #move to t0[t1],make it t4
   slli t1,t1,2
   add t4,t0,t1
   
   #load,change the bit,save
   lw t5, 0(t4)
   and t5,t5,t3
   sw t5,0(t4)  
pmm_clear_done:
   ret
   
pmm_test_block:
   # a0 = block; returns a0 = 0 (free/invalid) or 1 (used)
   la t6,pmm_total_blocks
   lw t6,0(t6)
   bgeu a0,t6,pmm_test_invalid

   la t0,pmm_bitmap  #address of variable in t0
   lw t0, 0(t0)  #address of array,basically pointer situation
   
   srli t1,a0,5
   
   andi t3,a0,31
   li t4,1
   sll t4,t4,t3
   
   
   slli t1,t1,2
   add t6,t0,t1
   lw t5,0(t6)
   
   and a0,t5,t4
   snez a0,a0
   ret
pmm_test_invalid:
   li a0,0
   ret

# Allocation bitmap helpers.  These record pages handed out by
# pmm_alloc_block, separately from pages permanently reserved by the kernel.
pmm_set_allocated_block:
   la t6,pmm_total_blocks
   lw t6,0(t6)
   bgeu a0,t6,pmm_set_allocated_done
   la t0,pmm_allocated_bitmap
   lw t0,0(t0)
   srli t1,a0,5
   andi t2,a0,31
   li t3,1
   sll t3,t3,t2
   slli t1,t1,2
   add t4,t0,t1
   lw t5,0(t4)
   or t5,t5,t3
   sw t5,0(t4)
pmm_set_allocated_done:
   ret

pmm_clear_allocated_block:
   la t6,pmm_total_blocks
   lw t6,0(t6)
   bgeu a0,t6,pmm_clear_allocated_done
   la t0,pmm_allocated_bitmap
   lw t0,0(t0)
   srli t1,a0,5
   andi t2,a0,31
   li t3,1
   sll t3,t3,t2
   not t3,t3
   slli t1,t1,2
   add t4,t0,t1
   lw t5,0(t4)
   and t5,t5,t3
   sw t5,0(t4)
pmm_clear_allocated_done:
   ret

pmm_test_allocated_block:
   la t6,pmm_total_blocks
   lw t6,0(t6)
   bgeu a0,t6,pmm_test_allocated_invalid
   la t0,pmm_allocated_bitmap
   lw t0,0(t0)
   srli t1,a0,5
   andi t2,a0,31
   li t3,1
   sll t3,t3,t2
   slli t1,t1,2
   add t4,t0,t1
   lw t5,0(t4)
   and a0,t5,t3
   snez a0,a0
   ret
pmm_test_allocated_invalid:
   li a0,0
   ret
   
pmm_reserve_region:
    addi sp, sp, -16
    sw   ra, 12(sp)
    sw   s0, 8(sp)
    sw   s1, 4(sp)

    # Reserve every page touched by [start, start + size).
    beqz a1, pmm_reserve_done
    srli s0, a0, 12                # first block = floor(start / PAGE_SIZE)
    la   t0, pmm_total_blocks
    lw   t0, 0(t0)
    bgeu s0, t0, pmm_reserve_done

    add  t1, a0, a1                # low 32 bits of end (exclusive)
    bltu t1, a0, pmm_reserve_cap    # end is >= 4 GiB; cap at managed memory
    addi t2, t1, 4095
    bltu t2, t1, pmm_reserve_cap    # rounding would cross 4 GiB
    srli s1, t2, 12                # end block = ceil(end / PAGE_SIZE)
    bltu t0, s1, pmm_reserve_cap
    j    pmm_reserve_loop

pmm_reserve_cap:
    mv   s1, t0

pmm_reserve_loop:
    bgeu s0, s1, pmm_reserve_done
    mv   a0, s0
    call pmm_set_block
    addi s0, s0, 1
    j    pmm_reserve_loop

pmm_reserve_done:
    lw   ra, 12(sp)
    lw   s0, 8(sp)
    lw   s1, 4(sp)
    addi sp, sp, 16
    ret
    



pmm_free_region:
    addi sp, sp, -16
    sw   ra, 12(sp)
    sw   s0, 8(sp)
    sw   s1, 4(sp)

    # Free only pages fully contained in [start, start + size).
    beqz a1, pmm_free_region_done
    la   t0, pmm_total_blocks
    lw   t0, 0(t0)

    addi t1, a0, 4095
    bltu t1, a0, pmm_free_region_done  # first full page begins above 4 GiB
    srli s0, t1, 12                   # first block = ceil(start / PAGE_SIZE)
    bgeu s0, t0, pmm_free_region_done

    add  t1, a0, a1                   # end is exclusive
    bltu t1, a0, pmm_free_region_cap   # end is >= 4 GiB
    srli s1, t1, 12                   # end block = floor(end / PAGE_SIZE)
    bltu t0, s1, pmm_free_region_cap
    j    pmm_free_region_loop

pmm_free_region_cap:
    mv   s1, t0

pmm_free_region_loop:
    bgeu s0, s1, pmm_free_region_done
    mv   a0, s0
    call pmm_clear_block
    addi s0, s0, 1
    j    pmm_free_region_loop

pmm_free_region_done:
    lw   ra, 12(sp)
    lw   s0, 8(sp)
    lw   s1, 4(sp)
    addi sp, sp, 16
    ret
    
    
pmm_init:
    addi sp, sp, -48
    sw   ra, 44(sp)
    sw   s2, 40(sp)
    sw   s3, 36(sp)
    sw   s4, 32(sp)
    sw   s5, 28(sp)
    sw   s6, 24(sp)
    sw   s7, 20(sp)
    sw   s8, 16(sp)
    sw   s9, 12(sp)
    sw   s1, 8(sp)
    sw   s0, 4(sp)

    mv   s9, a0                        # s9 = mboot_info, saved for the whole function

    la   t0, _kernel_end
    mv   s0, t0                        # highest occupied address so far
    li   t1, 134217728
    lw   t2, 0(a0)
    andi t2, t2, 1
    beqz t2, skip_mem_calc
    # Multiboot mem_upper is the KiB count beginning at 1 MiB.  Do not add
    # mem_lower here: conventional memory is not contiguous with mem_upper.
    lw   t4, 8(a0)
    slli t4, t4, 10
    li   t5, 1048576
    add  t1, t4, t5
skip_mem_calc:
    # Prefer the highest usable, below-4-GiB address in a valid memory map.
    # If no usable entry is found, retain the mem_upper/default fallback.
    mv   s1, t1
    li   s2, 0
    lw   t2, 0(s9)
    li   t3, 64
    and  t2, t2, t3
    beqz t2, pmm_init_total_use_fallback
    lw   t3, 44(s9)                    # mmap_length
    lw   t4, 48(s9)                    # mmap_addr
    add  t5, t4, t3
    bltu t5, t4, pmm_init_total_use_fallback
    mv   t6, t4
pmm_init_total_mmap_loop:
    bgeu t6, t5, pmm_init_total_done
    sub  t0, t5, t6
    li   t1, 4
    bltu t0, t1, pmm_init_total_use_fallback
    lw   t1, 0(t6)
    li   t2, 20
    bltu t1, t2, pmm_init_total_use_fallback
    addi t1, t1, 4
    bltu t1, t2, pmm_init_total_use_fallback
    bltu t0, t1, pmm_init_total_use_fallback

    lw   t2, 8(t6)                     # base_addr_high
    bnez t2, pmm_init_total_mmap_next
    lw   t2, 16(t6)                    # length_high
    bnez t2, pmm_init_total_mmap_next
    lw   t2, 20(t6)                    # type
    li   t3, 1
    bne  t2, t3, pmm_init_total_mmap_next
    lw   t2, 4(t6)                     # base_addr_low
    lw   t3, 12(t6)                    # length_low
    add  t4, t2, t3
    bltu t4, t2, pmm_init_total_mmap_next
    bgeu s2, t4, pmm_init_total_mmap_next
    mv   s2, t4
pmm_init_total_mmap_next:
    add  t6, t6, t1
    j    pmm_init_total_mmap_loop

pmm_init_total_done:
    bnez s2, pmm_init_total_ready
pmm_init_total_use_fallback:
    mv   s2, s1
pmm_init_total_ready:
    srli t6, s2, 12
    la   t2, pmm_total_blocks
    sw   t6, 0(t2)

    lw   t2, 0(a0)
    andi t2, t2, 8
    beqz t2, skip_mods
    lw   t2, 20(a0)
    beqz t2, skip_mods
    lw   t3, 24(a0)
    lw   t4, 20(a0)
    li   t5, 0
loop_mods:
    bgeu t5, t4, skip_mods
    slli t6, t5, 4
    add  t6, t3, t6
    lw   t6, 4(t6)
    bgeu s0, t6, skip_update
    mv   s0, t6
skip_update:
    addi t5, t5, 1
    j    loop_mods
skip_mods:

    addi t1, s0, 4095
    li   t2, 4095
    not  t2, t2
    and  t0, t1, t2
    mv   s7, t0                       # s7 = bitmap_start, saved
    la   t1, pmm_bitmap
    sw   t0, 0(t1)

    la   t1, pmm_total_blocks
    lw   t1, 0(t1)
    srli t2, t1, 5
    andi t3, t1, 31
    beqz t3, skip_round
    addi t2, t2, 1
skip_round:
    mv   s8, t2                       # s8 = num_words, saved

    # The usage bitmap and allocation bitmap must both fit in managed memory.
    slli t0, s8, 2
    add  t1, s7, t0
    bltu t1, s7, pmm_init_fail
    la   t2, pmm_allocated_bitmap
    sw   t1, 0(t2)
    add  t2, t1, t0
    bltu t2, t1, pmm_init_fail
    bltu s2, t2, pmm_init_fail

    la   t4, pmm_bitmap
    lw   t4, 0(t4)
    li   t5, -1
    li   t6, 0
fill_loop:
    bgeu t6, s8, fill_done             # use s8, not t2 (t2 gets clobbered later)
    slli t3, t6, 2
    add  t3, t4, t3
    sw   t5, 0(t3)
    addi t6, t6, 1
    j    fill_loop
fill_done:

    # No page has been allocated yet, even though the usage bitmap starts
    # with every page marked reserved.
    la   t4, pmm_allocated_bitmap
    lw   t4, 0(t4)
    li   t5, 0
    li   t6, 0
fill_allocated_loop:
    bgeu t6, s8, fill_allocated_done
    slli t3, t6, 2
    add  t3, t4, t3
    sw   t5, 0(t3)
    addi t6, t6, 1
    j    fill_allocated_loop
fill_allocated_done:

    li   t0, 1
    slli t0, t0, 6
    lw   t1, 0(s9)                     # use s9, not a0 (a0 no longer holds mboot_info here)
    and  t0, t0, t1
    beqz t0, do_fallback
    lw   s3, 44(s9)
    lw   s4, 48(s9)
    add  s5, s3, s4
    bltu s5, s4, skip_mmap             # malformed mmap range
    mv   s6, s4
mmap_loop:
    bgeu s6, s5, skip_mmap

    # A Multiboot entry is size bytes plus its 4-byte size field.  Validate
    # it before reading type/base/length or advancing the cursor.
    sub  t0, s5, s6
    li   t1, 4
    bltu t0, t1, skip_mmap
    lw   t5, 0(s6)
    li   t1, 20
    bltu t5, t1, skip_mmap
    addi t1, t5, 4
    bltu t1, t5, skip_mmap
    bltu t0, t1, skip_mmap
    add  s1, s6, t1                    # saved next entry; calls may clobber t registers

    # This PMM is RV32.  Ignore entries that cannot be represented below 4 GiB.
    lw   t2, 8(s6)                     # base_addr_high
    bnez t2, next_entry
    lw   t2, 16(s6)                    # length_high
    bnez t2, next_entry
    lw   t5, 20(s6)
    li   t6, 1
    bne  t5, t6, next_entry
    lw   a0, 4(s6)
    lw   a1, 12(s6)
    call pmm_free_region
next_entry:
    mv   s6, s1
    j    mmap_loop
do_fallback:
    li   a0, 0x100000
    bgeu a0, s2, skip_mmap
    sub  a1, s2, a0
    call pmm_free_region
skip_mmap:

    # --- reserve calls start here ---
    li   a0, 0
    li   a1, 0x100000
    call pmm_reserve_region

    li   a0, 0x100000
    la   t0, _kernel_end
    li   t1, 0x100000
    bltu t0, t1, skip_reserve_kernel
    sub  a1, t0, t1
    call pmm_reserve_region
skip_reserve_kernel:

    lw   t0, 0(s9)
    andi t0, t0, 8
    beqz t0, skip_reserve_mods
    lw   t0, 20(s9)
    beqz t0, skip_reserve_mods
    lw   s3, 24(s9)
    lw   s4, 20(s9)
    li   s5, 0
reserve_mods_loop:
    bgeu s5, s4, skip_reserve_mods
    slli t0, s5, 4
    add  t0, s3, t0
    lw   t1, 0(t0)
    lw   t2, 4(t0)
    bltu t2, t1, reserve_mods_next
    mv   a0, t1
    sub  a1, t2, t1
    call pmm_reserve_region
reserve_mods_next:
    addi s5, s5, 1
    j    reserve_mods_loop
skip_reserve_mods:

    mv   a0, s7
    slli a1, s8, 3                  # reserve both bitmap arrays
    call pmm_reserve_region
    # --- reserve calls end here ---

    j    pmm_init_done

pmm_init_fail:
    # Leave PMM disabled rather than writing outside managed physical memory.
    la   t0, pmm_bitmap
    sw   zero, 0(t0)
    la   t0, pmm_total_blocks
    sw   zero, 0(t0)
    la   t0, pmm_allocated_bitmap
    sw   zero, 0(t0)

pmm_init_done:
    lw   ra, 44(sp)
    lw   s2, 40(sp)
    lw   s3, 36(sp)
    lw   s4, 32(sp)
    lw   s5, 28(sp)
    lw   s6, 24(sp)
    lw   s7, 20(sp)
    lw   s8, 16(sp)
    lw   s9, 12(sp)
    lw   s1, 8(sp)
    lw   s0, 4(sp)
    addi sp, sp, 48
    ret
    
pmm_alloc_block:
    addi sp, sp, -16
    sw   ra, 12(sp)
    sw   s0, 8(sp)
    sw   s1, 4(sp)
    sw   s2, 0(sp)

    la   t0, pmm_total_blocks
    lw   t0, 0(t0)
    addi t0, t0, 31
    srli s0, t0, 5              # s0 = ceil(total_blocks / 32)

    la   t0, pmm_bitmap
    lw   s1, 0(t0)                 # s1 = pmm_bitmap (array base)

    li   s2, 0                       # s2 = i = 0

outer_loop:
    bgeu s2, s0, alloc_panic

    slli t0, s2, 2
    add  t0, s1, t0
    lw   t1, 0(t0)

    li   t2, -1
    beq  t1, t2, next_word

    li   t4, 32
    li   t3, 0                          # t3 = bit
inner_loop:
    bgeu t3, t4, next_word

    li   t5, 1
    sll  t5, t5, t3

    and  t6, t1, t5
    bnez t6, inner_next

    slli t0, s2, 5
    add  t0, t0, t3                       # t0 = block

    mv   s0, t0                             # save block into s0 — SAFE, we're done needing num_words by now

    mv   a0, t0
    call pmm_set_block

    mv   a0, s0
    call pmm_set_allocated_block

    slli a0, s0, 12                            # a0 = block * PAGE_SIZE (use s0, survived the call)
    j    alloc_done

inner_next:
    addi t3, t3, 1
    j    inner_loop

next_word:
    addi s2, s2, 1
    j    outer_loop

alloc_panic:
    # printf(...) omitted — would need a call to your terminal/print routine here
    # while(1) { cli; hlt; }
panic_loop:
    li   a0, 0              # page zero is the out-of-memory return value
    j    alloc_done

alloc_done:
    lw   ra, 12(sp)
    lw   s0, 8(sp)
    lw   s1, 4(sp)
    lw   s2, 0(sp)
    addi sp, sp, 16
    ret
    
pmm_free_block:
    addi sp, sp, -16
    sw   ra, 12(sp)
    sw   s0, 8(sp)
    # a0 = page-aligned physical address returned by pmm_alloc_block.
    # 4095 does not fit in the signed 12-bit immediate accepted by andi.
    li   t0, 4095
    and  t0, a0, t0
    bnez t0,skip_free
    srli s0,a0,12
    
    la t1,pmm_total_blocks
    lw t1,0(t1)
    bgeu s0,t1,skip_free

    # Refuse to free pages that were never allocated by pmm_alloc_block.
    mv a0,s0
    call pmm_test_allocated_block
    beqz a0,skip_free

    mv a0,s0
    call pmm_clear_allocated_block
    mv a0,s0
    call pmm_clear_block
    
skip_free:
    lw ra,12(sp)
    lw s0,8(sp)
    addi sp,sp,16
    ret
